# CPU HyperNOID Miner v1.0.0 optional systemd user-service settings.
# Copy to ~/.config/hypernoid-miner/miner.env and edit every placeholder.
# This is systemd EnvironmentFile syntax: no "export" and no shell commands.
# Pool and wallet below belong to YOUR phase. The disclosed fee uses its fixed policy.
HYPERNOID_POOL=pool.example:19601
HYPERNOID_WALLET=REPLACE_WITH_YOUR_PUBLIC_NOID_ADDRESS
HYPERNOID_WORKER=HomeCPU
HYPERNOID_THREADS=4
HYPERNOID_STOP_C=REPLACE_WITH_YOUR_CPU_LIMIT
